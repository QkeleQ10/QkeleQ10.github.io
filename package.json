{
  "name": "qkeleq10-github-io",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "expose": "vite --host",
    "build": "vite build && node -e \"const fs=require('fs'),path=require('path');['404.html','studytools.html','graphic-design.html','studytools/grades.html'].forEach(file=>{const target=path.join('dist',file);fs.mkdirSync(path.dirname(target),{recursive:true});fs.copyFileSync('dist/index.html',target)})\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vueuse/components": "^15.0.0",
    "@vueuse/core": "^15.0.0",
    "intl-messageformat": "^12.1.3",
    "pinia": "^4.0.3",
    "typescript-cookie": "^1.0.6",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  }
}
